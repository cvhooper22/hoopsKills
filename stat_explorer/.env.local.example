# Copy to .env.local (already gitignored) and fill in real values.
# Base URL of the admin API (API Gateway invoke URL incl. stage, no trailing slash).
# See ../alum-admin-lambda/README.md. This is just a URL, not a secret: the editor
# asks for the password at runtime and the API enforces it server-side.
REACT_APP_ADMIN_API_URL=https://abc123xyz.execute-api.YOUR_REGION.amazonaws.com/prod

# Feature flags (see src/constants/featureFlags.js). Build-time default; the runtime
# flags.json on the data CloudFront and a personal ?ff=<name> override both take precedence.
# Leave unset in production builds so unfinished features stay off.
REACT_APP_FF_COLLECTION=true

# Local `npm start` only: the dev server proxy sends this as the admin password so the
# admin pages open without a login prompt. Not REACT_APP_-prefixed, so it never enters the
# bundle, and the proxy doesn't exist in production builds (which always ask for the password).
ADMIN_PASSWORD=
